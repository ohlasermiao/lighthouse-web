{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lighthouse-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "3024529f59fb4bae9333dfea9e56ed1f"
    }
  ],
  "routes": [
    {
      "pattern": "lighthouse.sync-value.com",
      "custom_domain": true
    }
  ]
}
